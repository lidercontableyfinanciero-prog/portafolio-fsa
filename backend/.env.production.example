# Backend — variables para producción (Render / Railway / Fly / Docker)
# El código normaliza postgres:// y postgresql:// a postgresql+psycopg://
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/portafolio_fsa

# >= 32 bytes. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR-por-una-cadena-aleatoria-de-al-menos-32-bytes

ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=false

# Dominios del frontend autorizados (JSON array)
BACKEND_CORS_ORIGINS=["https://tu-frontend.example.com"]

# Ejecutar el seed en el arranque del contenedor (1) o no (0).
# Solo tiene efecto si la carpeta de datos fuente está montada.
RUN_SEED=0

# Procesos uvicorn
WEB_CONCURRENCY=2
